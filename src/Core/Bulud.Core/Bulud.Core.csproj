<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Bulud.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>BuludWeb</Authors>
    <Company>BuludWeb</Company>
    <Description>Dependency-free shared primitives for Bulud.NET packages.</Description>
    <PackageTags>bulud core primitives</PackageTags>
    <RepositoryUrl>https://github.com/shayanblest/Bulud.NET.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/shayanblest/Bulud.NET.git</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

</Project>
