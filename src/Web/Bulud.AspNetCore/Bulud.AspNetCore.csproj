<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Bulud.AspNetCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>BuludWeb</Authors>
    <Company>BuludWeb</Company>
    <Description>ASP.NET Core integration for Bulud.NET capabilities.</Description>
    <PackageTags>bulud aspnetcore web</PackageTags>
    <RepositoryUrl>https://github.com/shayanblest/Bulud.NET.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/shayanblest/Bulud.NET.git</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FileStorage\Bulud.FileStorage.Abstractions\Bulud.FileStorage.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\Bulud.Core\Bulud.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" />
  </ItemGroup>

</Project>
