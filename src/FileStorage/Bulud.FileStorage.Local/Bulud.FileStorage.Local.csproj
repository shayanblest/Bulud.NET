<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Bulud.FileStorage.Local</PackageId>
        <Version>2.0.0</Version>
        <Authors>BuludWeb</Authors>
        <Company>BuludWeb</Company>
        <Description>
            Bulud.FileStorage.Local is a .NET library providing local file storage implementation
            for the Bulud.FileStorage.Abstractions IFilesService interface. Features include:
            - Upload, download, delete, and move files on local disk
            - Implements the Bulud.FileStorage.Abstractions contracts
            - Easy integration with .NET DI
        </Description>
        <PackageTags>bulud local file storage net</PackageTags>
        <RepositoryUrl>https://github.com/shayanblest/Bulud.NET.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/shayanblest/Bulud.NET.git</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bulud.FileStorage.Abstractions\Bulud.FileStorage.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

</Project>
